
# Restore the A35x startup sequence from the known-booting recovery image.
# Keep the configfs properties needed for a later USB/ADB diagnostic pass.

on early-init
    mkdir /mnt/vendor/efs 0771 radio system
    # No ocultar /vendor/tee: extract_ta.sh valida los TA del vendor real montado por first-stage.
    start extract_ta

on late-init
    setprop sys.usb.controller 13200000.dwc3
    setprop service.adb.root 1
    setprop sys.usb.configfs 1
    setprop sys.usb.config adb

on fs
    wait /dev/block/platform/${ro.boot.boot_devices}
    symlink /dev/block/platform/${ro.boot.boot_devices} /dev/block/bootdevice
    symlink /dev/block/platform/${ro.boot.boot_devices}/by-name /dev/block/by-name
    symlink /dev/block/platform/${ro.boot.boot_devices}/by-name/param /dev/block/param
    chown root system /dev/block/param
    chmod 0666 /dev/block/param

on boot
    start health-hal-2-1

service extract_ta /sbin/extract_ta.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

# Importar TEEGRIS después de preparar /dev/block/by-name en el evento fs.
# Evita que el wait de efs/sec_efs se ejecute antes de crear los symlinks.
import /init.recovery.teegris.rc

# AERA Host API 2 device plugins. /tmp is a tmpfs created by AERA's init.rc,
# so seed the RAM plugin registry after post-fs-data and before the UI starts.
on post-fs-data
    mkdir /tmp/aera 0700 root root
    mkdir /tmp/aera/plugins 0700 root root
    mkdir /tmp/aera/plugins/gsi-manager 0700 root root
    copy /system/etc/aera/plugins/gsi-manager/plugin.json /tmp/aera/plugins/gsi-manager/plugin.json
    copy /system/etc/aera/plugins/gsi-manager/runtime.xz /tmp/aera/plugins/gsi-manager/runtime.xz
    chmod 0444 /tmp/aera/plugins/gsi-manager/plugin.json
    chmod 0444 /tmp/aera/plugins/gsi-manager/runtime.xz
    mkdir /tmp/aera/plugins/emergency-mode 0700 root root
    copy /system/etc/aera/plugins/emergency-mode/plugin.json /tmp/aera/plugins/emergency-mode/plugin.json
    copy /system/etc/aera/plugins/emergency-mode/runtime.xz /tmp/aera/plugins/emergency-mode/runtime.xz
    chmod 0444 /tmp/aera/plugins/emergency-mode/plugin.json
    chmod 0444 /tmp/aera/plugins/emergency-mode/runtime.xz
